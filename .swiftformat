# SwiftFormat configuration for MemoryEcho
# Docs: https://github.com/nicklockwood/SwiftFormat/blob/main/Rules.md
# `make format` rewrites files; `make format-check` only verifies (used in CI).

--swiftversion 6.0

# Paths SwiftFormat should never touch. `build` is where `make deploy`/`make ipa`
# drop device-build artifacts — gitignored, so kept out of linting too.
--exclude .build,MemoryEchoCore/.build,DerivedData,build,**/.build

# A light, opinionated baseline — mostly defaults with a few choices spelled out.
--self remove                 # drop redundant `self.`
--importgrouping testable-bottom
--commas inline
--trimwhitespace always
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--maxwidth 120                # keep in step with SwiftLint line_length warning

# Rules we opt out of. `wrapIfStatementBodies` arrived on by default in 0.62.0
# and would explode ~47 single-line guards (`if x <= 0 { return .today }`) into
# three lines each. Keep the compact form.
--disable wrapIfStatementBodies

# Anyone below this fails on the --disable above (0.61.x errors on the unknown
# rule name), and CI installs the current Homebrew swiftformat.
--minversion 0.62.0
